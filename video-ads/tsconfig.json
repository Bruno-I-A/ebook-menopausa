{
  "compilerOptions": {
    "lib": ["dom", "es2017"],
    "jsx": "react",
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
